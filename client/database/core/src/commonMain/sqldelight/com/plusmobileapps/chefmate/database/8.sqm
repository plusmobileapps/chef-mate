-- User-defined grocery autocomplete entries (see GroceryAutocompleteItem.sq).
-- Sync-ready columns (remoteId, clientId, isDirty, ownerId) are unused while the
-- feature is local-only; a follow-up wires Supabase sync without a migration.
CREATE TABLE GroceryAutocompleteItem (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    createdAt TEXT NOT NULL DEFAULT (datetime('now')),
    remoteId TEXT UNIQUE,
    clientId TEXT,
    isDirty INTEGER NOT NULL DEFAULT 0,
    ownerId TEXT
);

CREATE UNIQUE INDEX idx_grocery_autocomplete_name ON GroceryAutocompleteItem(name COLLATE NOCASE);
