import kotlin.Boolean;

-- User-defined grocery autocomplete entries. These augment the built-in
-- IngredientParser vocabulary so a user's own staples autocomplete on the
-- grocery list.
--
-- `remoteId`, `clientId`, `isDirty`, and `ownerId` mirror the Category table's
-- sync scaffolding. Items are add/delete only (never renamed), so `isDirty` is
-- unused — there is no local edit to reconcile — but it is kept for symmetry
-- with Category and to avoid a future migration should editing be added.
CREATE TABLE GroceryAutocompleteItem (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    createdAt TEXT NOT NULL DEFAULT (datetime('now')),
    remoteId TEXT UNIQUE,
    clientId TEXT,
    isDirty INTEGER AS Boolean NOT NULL DEFAULT 0,
    ownerId TEXT
);

-- Case-insensitive uniqueness keeps the user list free of "Milk"/"milk" dupes.
CREATE UNIQUE INDEX idx_grocery_autocomplete_name ON GroceryAutocompleteItem(name COLLATE NOCASE);

getAll:
SELECT * FROM GroceryAutocompleteItem ORDER BY name COLLATE NOCASE ASC;

getById:
SELECT * FROM GroceryAutocompleteItem WHERE id = ?;

getByName:
SELECT * FROM GroceryAutocompleteItem WHERE name = ? COLLATE NOCASE;

getByRemoteId:
SELECT * FROM GroceryAutocompleteItem WHERE remoteId = ?;

getByClientId:
SELECT * FROM GroceryAutocompleteItem WHERE clientId = ?;

insertOrIgnore:
INSERT OR IGNORE INTO GroceryAutocompleteItem (name, clientId, ownerId) VALUES (?, ?, ?);

createWithRemoteId:
INSERT INTO GroceryAutocompleteItem (name, remoteId, clientId, ownerId)
VALUES (?, ?, ?, ?)
ON CONFLICT(remoteId) DO UPDATE SET
    name = excluded.name,
    clientId = excluded.clientId,
    ownerId = excluded.ownerId;

lastInsertId:
SELECT MAX(id) FROM GroceryAutocompleteItem;

getUnsynced:
SELECT * FROM GroceryAutocompleteItem WHERE remoteId IS NULL;

updateRemoteId:
UPDATE GroceryAutocompleteItem SET remoteId = ?, isDirty = 0 WHERE id = ?;

updateClientId:
UPDATE GroceryAutocompleteItem SET clientId = ? WHERE id = ?;

deleteById:
DELETE FROM GroceryAutocompleteItem WHERE id = ?;

deleteAll:
DELETE FROM GroceryAutocompleteItem;
