CREATE TABLE AiChatMessage (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    conversationId INTEGER NOT NULL REFERENCES AiChatConversation(id) ON DELETE CASCADE,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    isStreaming INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_ai_chat_message_created_at ON AiChatMessage(createdAt);
CREATE INDEX idx_ai_chat_message_conversation ON AiChatMessage(conversationId);

getAllForConversation:
SELECT * FROM AiChatMessage WHERE conversationId = ? ORDER BY createdAt ASC, id ASC;

insertMessage:
INSERT INTO AiChatMessage(conversationId, role, content, createdAt, isStreaming)
VALUES (?, ?, ?, ?, ?)
RETURNING id;

updateContent:
UPDATE AiChatMessage SET content = ?, isStreaming = ? WHERE id = ?;

deleteAll:
DELETE FROM AiChatMessage;
