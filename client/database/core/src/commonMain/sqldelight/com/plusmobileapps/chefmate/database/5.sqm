-- Adds the RecipeBook table and links every Recipe to a book.
--
-- A RecipeBook holds a collection of recipes. Every user gets a single default
-- "My Recipes" book (isDefault = 1); recipes that predate this migration are
-- backfilled onto it. ownerId is left NULL until the next sync stamps it, exactly
-- like existing unsynced recipes carry ownerId = NULL until their first push.

CREATE TABLE RecipeBook (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    isDefault INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL DEFAULT (datetime('now')),
    updatedAt TEXT NOT NULL DEFAULT (datetime('now')),
    remoteId TEXT UNIQUE,
    clientId TEXT,
    isDirty INTEGER NOT NULL DEFAULT 0,
    ownerId TEXT,
    isPendingDelete INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_recipe_book_owner ON RecipeBook(ownerId);

-- Seed the single local default book.
INSERT INTO RecipeBook (name, isDefault) VALUES ('My Recipes', 1);

-- Add the nullable FK column (nullable => no constant-default requirement under
-- SQLite's ADD COLUMN), then backfill every existing recipe onto the default book.
ALTER TABLE Recipe ADD COLUMN recipeBookId INTEGER REFERENCES RecipeBook(id);

UPDATE Recipe SET recipeBookId = (SELECT id FROM RecipeBook WHERE isDefault = 1 LIMIT 1);
