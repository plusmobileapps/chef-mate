#!/usr/bin/env bash

# Run ktfmt on staged .kt/.kts files before committing

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kts?$')

if [ -z "$staged_files" ]; then
    exit 0
fi

if ! command -v ktfmt &> /dev/null; then
    echo "ktfmt not found. Install with: brew install ktfmt"
    exit 1
fi

echo "$staged_files" | xargs ktfmt --kotlinlang-style 2>&1
echo "$staged_files" | xargs git add

exit 0
